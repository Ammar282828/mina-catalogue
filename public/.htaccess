# The upload secret, if it is ever kept inside the web root rather than above
# it, must never be served. Denied before any rewrite can reach it.
<FilesMatch "^\.(website-upload-secret|mina-catalogue)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # HTTPS only. The certificate is Hostinger's free one (Let's Encrypt, renewed
  # by the host); every canonical URL and the POS's uploads use https.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

  # One URL shape for every document route: no trailing slash.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Page 1 of a gallery is the bare collection path.
  RewriteRule ^([^/]+)/1$ /$1 [R=301,L]

  # The catalogue was first arranged by style (Engagement Rings, Gemstone Rings,
  # Studs…); since 2026-09-23 it is five categories by what the piece is, as on
  # taheri.shop, and a Men's section. Old addresses keep working: a retired
  # collection goes to its category, a piece under it to the same piece there
  # (piece slugs are unique site-wide, so /gemstone-rings/x is /rings-and-bands/x).
  # Mirrors RETIRED in src/lib/taxonomy.js.
  RewriteRule ^(?:rings|engagement-rings|gemstone-rings|cocktail-rings|everyday-rings)(/.*)?$ /rings-and-bands$1 [R=301,L]
  RewriteRule ^(?:bracelets|tennis-bracelets|everyday-bracelets|bangles-and-cuffs)(/.*)?$ /wristwear$1 [R=301,L]
  RewriteRule ^(?:necklaces|pendants|chokers|everyday-necklaces)(/.*)?$ /chains-and-pendants$1 [R=301,L]
  RewriteRule ^(?:studs|hoops-and-huggies|statement-earrings|everyday-earrings)(/.*)?$ /earrings$1 [R=301,L]

  # Men's became a section of its own later on 2026-09-23, with sub-categories
  # (/men, /mens-rings, /natural-ruby-rings, /mens-chains, /mens-bracelets); the
  # For Him edit it replaces goes there, and each men's piece moved out of the
  # category of its type to the same slug under its sub-category.
  RewriteRule ^for-him(/.*)?$ /men$1 [R=301,L]
  RewriteRule ^rings-and-bands/(emblem-ring|grooved-baguette-band|metro-ring|ridge-ring|tri-channel-ring)$ /mens-rings/$1 [R=301,L]
  RewriteRule ^rings-and-bands/(natural-ruby-ring-no-[0-9]+)$ /natural-ruby-rings/$1 [R=301,L]
  RewriteRule ^chains-and-pendants/(box-chain|cuban-chain|curb-diamond-cut-chain|rope-chain|snake-chain)$ /mens-chains/$1 [R=301,L]
  RewriteRule ^wristwear/(verso-mens-cuff|zobi-mens-silver-cuff|cuban-bracelet|link-bracelet|rope-bracelet)$ /mens-bracelets/$1 [R=301,L]

  # /rings-and-bands.html and /rings-and-bands are one page; send the .html form to the clean one.
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
  RewriteCond %1 !^(?:index|404)$
  RewriteRule ^ /%1 [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]
  RewriteRule ^index\.html$ - [L]

  # Every prerendered route is a file: /rings-and-bands/elara-ring → .html.
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# Anything else is the app shell, which knows routes the build did not
# (a photo uploaded from the counter since the last deploy).
ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:webp|png|jpe?g|svg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "(?:\.html$|^(?:sitemap\.xml|image-sitemap\.xml|robots\.txt|llms\.txt|catalog-tree\.json)$)">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
